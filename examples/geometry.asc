// A module: other files load it with `import geometry`.
// Every top-level name is exported, except names starting with an underscore.

const PI_2 = PI * 2

f64 circle_area(f64 radius) {
    return PI * radius ** 2
}

f64 circle_circumference(f64 radius) {
    return PI_2 * radius
}

f64 distance(map a, map b) {
    return hypot(b.x - a.x, b.y - a.y)
}

void _check(f64 value) {
    assert(value >= 0, "expected a non-negative value")
}
