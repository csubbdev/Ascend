// Structs group named, typed fields. Enums give names to numbers.

struct Point {
    f64 x
    f64 y
}

struct Rect {
    Point origin          // fields can be structs too
    f64 width = 1
    f64 height = 1
    string label = "rect"
}

enum Shape { Square, Wide, Tall }

f64 area(Rect r) {
    return r.width * r.height
}

i32 shape(Rect r) {
    if (r.width == r.height) return Shape.Square
    return r.width > r.height ? Shape.Wide : Shape.Tall
}

// The constructor takes the fields in order; the rest get their defaults.
Rect door = Rect(Point(1, 2), 1, 2, "door")
print(door)
print("area:", door.area())           // the same as area(door)
print("tall?", door.shape() == Shape.Tall)

door.width = 2                        // fields keep their types: door.width = "big" is an error
print("square now?", door.shape() == Shape.Square)

Rect unit                             // every field starts at its default
print(unit)
print(type(unit), type(unit.origin))

try {
    door.depth = 3
} catch e {
    print("error:", e)
}
