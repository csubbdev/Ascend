// Runtime errors can be caught with try/catch.
try {
    print(10 / 0)
} catch e {
    print("caught:", e)
}

// throw works with any value; a map is handy for structured errors.
func parseAge(text) {
    age := int(text)
    if age < 0 {
        throw {message: "age can't be negative", value: age}
    }
    return age
}

for input in ["42", "-5", "abc"] {
    try {
        print("age:", parseAge(input))
    } catch (err) {
        if type(err) == "map" {
            print("invalid:", err.message, "(" + err.value + ")")
        } else {
            print("invalid:", err)
        }
    }
}

assert(parseAge("7") == 7, "parseAge is broken")
print("done")
