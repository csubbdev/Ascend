// import() runs another file once and returns its top-level names as a map.
// Paths are relative to this file; ".asc" can be left out.
geometry := import("geometry")

print(f"area of a circle with radius 2: {geometry.circle_area(2):.3f}")
print(f"circumference: {geometry.circle_circumference(2):.3f}")
print("distance:", geometry.distance({x: 0, y: 0}, {x: 3, y: 4}))
print("exports:", keys(geometry))
