// `import name` runs another file once and stores its top-level names in a
// map. Paths are relative to this file; `lib.shapes` means lib/shapes.asc.
import geometry

// `from ... import` takes just the names you need.
from geometry import circle_area, distance as dist

print(f"area of a circle with radius 2: {circle_area(2):.3f}")
print(f"circumference: {geometry.circle_circumference(2):.3f}")
print("distance:", dist({x: 0, y: 0}, {x: 3, y: 4}))
print("exports:", keys(geometry))
