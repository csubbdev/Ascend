// Inheritance, operator overloading, special methods and typed lists.

struct Point {
    f64 x
    f64 y
    Point operator+(Point other) { return Point(this.x + other.x, this.y + other.y) }
    bool operator==(Point other) { return this.x == other.x and this.y == other.y }
    string to_string() { return f"({this.x}, {this.y})" }
}

// The struct every shape extends.
struct Shape {
    string name
    Point origin = Point(0, 0)
    f64 area() { return 0 }
    string describe() { return f"{this.name} at {this.origin} with area {this.area():.2f}" }
    // Shapes compare by area, so they can be sorted.
    bool operator<(Shape other) { return this.area() < other.area() }
    string to_string() { return this.name }
}

struct Circle : Shape {
    f64 radius = 1
    f64 area() { return PI * this.radius ** 2 }
}

struct Rect : Shape {
    f64 width = 1
    f64 height = 1
    f64 area() { return this.width * this.height }
    string describe() { return super.describe() + (this.width == this.height ? " (a square)" : "") }
}

list<Shape> shapes = [
    Circle("wheel", radius: 2),
    Rect("door", Point(4, 0), width: 1, height: 2),
    Rect("tile", Point(1, 1) + Point(2, 2), width: 1.5, height: 1.5),
]

for (Shape s : shapes) print(s.describe())

print("smallest to largest:", sort(shapes))
print("largest:", max(shapes))
print("total area:", round(sum([s.area() for s in shapes]), 2))
print("circles:", [s for s in shapes if is_a(s, Circle)])
print("same point:", Point(1, 2) == Point(1, 2))

try {
    shapes.push("not a shape")
} catch e {
    print("error:", e)
}
