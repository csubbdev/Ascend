// f-strings put expressions inside {}; a format spec can follow a colon.
item := "coffee"
price := 3.5
quantity := 3
print(f"{quantity} x {item} = ${price * quantity:.2f}")

// Tables with alignment: < left, > right, ^ center
rows := [["apples", 3, 0.5], ["bananas", 12, 0.25], ["cherries", 100, 0.1]]
print(f"{"fruit":<10}|{"count":>6}|{"price":>7}")
print("-" * 25)
for row in rows {
    print(f"{row[0]:<10}|{row[1]:>6}|{row[2]:>7.2f}")
}

print(f"{1234567:,} | {0.875:.1%} | {255:x} | {255:08b} | {42:+}")
print(format("{} has {} letters", "Ascend", len("Ascend")))

// Chars are single characters, written with single quotes.
letter := 'a'
print(letter + 1, 'z' - 'a', upper(letter), '=' * 10)

// Strings are Unicode: indexing, slicing and len() count characters.
word := "naïve café"
print(len(word), word[2], word[6:], reverse(word))
for i, c in "héllo" {
    if not is_alpha(c) {
        print(f"position {i} has a non-ASCII letter: {c}")
    }
}

// A simple Caesar cipher using char arithmetic.
string shift(string text, i32 by) {
    result := ""
    for c in text {
        if c >= 'a' and c <= 'z' {
            result += char('a' + (c - 'a' + by) % 26)
        } else {
            result += c
        }
    }
    return result
}
secret := shift("hello world", 3)
print(secret, "->", shift(secret, 23))
