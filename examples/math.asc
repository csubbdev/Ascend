x := 10 + 5
print(x)  // Output: 15

y := x * 2
print(y)  // Output: 30

print("y value " + y)  // Output: y value 30

z := (y + 5) * 3
print(z)  // Output: 105

print("z value", z)   // Output: z value 105

mod := 17 % 5
print(mod)  // Output: 2

// Integer division truncates; use a float to get a fractional result.
print(7 / 2, 7 / 2.0)  // Output: 3 3.5

print(2 ** 10, sqrt(144), abs(-8))  // Output: 1024 12.0 8
print(round(PI, 3), floor(9.99), ceil(0.1))  // Output: 3.142 9 1

/*
multi-line comments woo hoo
*/
