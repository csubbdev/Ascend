// Structs with methods. A method gets the value it's called on as `this`.

struct Account {
    string owner
    f64 balance = 0
    list history = []

    // init() runs whenever an Account is made.
    void init() {
        if (this.balance < 0) throw "an account can't start below zero"
    }

    void deposit(f64 amount) {
        this.balance += amount
        this.history.push(f"+{amount:.2f}")
    }

    bool withdraw(f64 amount) {
        if (amount > this.balance) return false
        this.balance -= amount
        this.history.push(f"-{amount:.2f}")
        return true
    }

    string summary() {
        return f"{this.owner}: {this.balance:.2f} ({len(this.history)} transactions)"
    }
}

account := Account("Ada", 100)
account.deposit(25.5)
if (!account.withdraw(500)) print("not enough money for that")
account.withdraw(40)
print(account.summary())
print("history:", account.history)

// Named arguments work for constructors too.
savings := Account(owner: "Grace", balance: 1000)
print(savings.summary())

try {
    Account("Linus", -5)
} catch e {
    print("error:", e)
} finally {
    print("(finally always runs)")
}
