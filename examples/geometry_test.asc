// A test file: `ascend test` runs every file named *_test.asc or test_*.asc.
// A test passes when the file finishes without an error.
import geometry

assert(geometry.circle_area(1) == PI, "the area of a unit circle is pi")
assert(round(geometry.circle_circumference(1), 4) == 6.2832, "circumference")
assert(geometry.distance({x: 0, y: 0}, {x: 3, y: 4}) == 5, "a 3-4-5 triangle")
print("geometry tests passed")
