// Lambdas, comprehensions, ranges, destructuring, spreading and named arguments.

struct Sale {
    string item
    string region
    f64 amount
}

sales := [
    Sale("tea", "north", 12.5),
    Sale("coffee", "south", 30),
    Sale("tea", "south", 7.25),
    Sale("cake", "north", 18),
    Sale("coffee", "north", 22),
]

// Lambdas: x => expression, or (a, b) => { statements }
big := filter(sales, s => s.amount >= 15)
print("big sales:", [s.item for s in big])

// Comprehensions build lists and maps from loops.
by_region := group_by(sales, s => s.region)
totals := {region: sum([s.amount for s in list]) for region, list in by_region}
print("totals:", totals)

// Ranges: 1..5 stops before 5, 1..=5 includes it.
squares := [n * n for n in 1..=5]
print("squares:", squares, "evens below 10:", [n for n in 0..10 if n % 2 == 0])

// Functions can return several values, and callers can unpack them.
func spread_of(list values) {
    return min(values), max(values)
}
low, high := spread_of([s.amount for s in sales])
print(f"amounts go from {low} to {high}")

// ...rest collects extra arguments; ...list spreads a list into them.
f64 average(f64 ...values) {
    return sum(values) / len(values)
}
print("average:", average(...[s.amount for s in sales]))

// Arguments can be given by name, in any order, after the positional ones.
string describe(Sale s, string currency = "$", i32 decimals = 2) {
    return sprintf("%-7s %s%.*f", s.item, currency, decimals, s.amount)
}
for s in sales {
    print(describe(s, decimals: 1))
}

// a ?? b gives b when a is null; a?.b gives null instead of an error.
string? best = max_by(sales, s => s.amount)?.item
print("best seller:", best ?? "nothing")
