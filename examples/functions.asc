// Recursion
func factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}
print("10! =", factorial(10))

// Default parameter values
func greet(name, greeting = "Hello") {
    return greeting + ", " + name + "!"
}
print(greet("Ada"))
print(greet("Linus", "Hi"))

// Functions are values: they can be stored, passed around and returned
square := func(x) { return x * x }
print(map([1, 2, 3, 4], square))
print(filter(range(10), func(n) { return n % 3 == 0 }))
print(reduce([1, 2, 3, 4], func(total, n) { return total + n }))

// Closures remember the variables of the scope they were created in
func makeCounter() {
    count := 0
    return func() {
        count += 1
        return count
    }
}
next := makeCounter()
next()
next()
print("counter:", next())  // counter: 3

// Functions can be called before they are declared
print(isEven(10), isOdd(7))
func isEven(n) { return n == 0 ? true : isOdd(n - 1) }
func isOdd(n) { return n == 0 ? false : isEven(n - 1) }
