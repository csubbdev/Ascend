// Ascend can be written like C: for (;;) loops, ++ and --, switch,
// do/while, bodies without braces, casts, printf and a main() function.

enum Op { Add, Sub, Mul, Div }

f64 apply(i32 op, f64 a, f64 b) {
    switch (op) {
    case Op.Add: return a + b
    case Op.Sub: return a - b
    case Op.Mul: return a * b
    case Op.Div:
        if (b == 0) throw "division by zero"
        return a / b
    default:
        throw "unknown operation"
    }
}

// Like C, main() runs after the rest of the file. Its return value is the
// program's exit code.
int main(list args) {
    for (i32 i = 1; i <= 3; i++) {
        printf("%d squared is %2d\n", i, i * i)
    }

    // The Collatz sequence, with C-style bodies without braces.
    i32 n = 27
    i32 steps = 0
    while (n != 1) {
        if (n % 2 == 0) n /= 2
        else n = 3 * n + 1
        steps++
    }
    printf("27 reaches 1 after %d steps\n", steps)

    // do/while runs its body at least once.
    i32 tries = 0
    do {
        tries++
    } while (tries < 3)
    printf("tried %d times\n", tries)

    // Several variables in one for header.
    for (i32 low = 0, high = 9; low < high; low += 3, high -= 3) printf("%d..%d ", low, high)
    printf("\n")

    f64 average = (f64) 7 / 2  // a cast, so the division isn't an integer division
    printf("%-8s|%8.2f|\n", "average", average)

    for (i32 op : [Op.Add, Op.Sub, Op.Mul, Op.Div]) {
        printf("op %d: 6, 3 -> %g\n", op, apply(op, 6, 3))
    }
    return 0
}
