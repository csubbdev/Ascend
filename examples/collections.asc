// Lists
scores := [72, 95, 88]
scores.push(64)                    // same as push(scores, 64)
print(scores, "count:", len(scores))
print("first:", scores[0], "last:", scores[-1], "middle:", scores[1:3])
print("sorted:", scores.sort(), "best:", max(scores), "total:", sum(scores))

for i, score in scores {
    print("  #" + (i + 1), score >= 70 ? "pass" : "fail")
}

// Maps (insertion ordered)
person := {name: "Ada", born: 1815, "favorite number": 7}
person.languages = ["Analytical Engine"]
person["born"] += 0
print(person.name, "was born in", person.born)

for key, value in person {
    print("  " + key + ":", value)
}
print("has email?", "email" in person, "| email:", get(person, "email", "unknown"))

// Count words with a map
text := "the quick brown fox jumps over the lazy dog the end"
counts := {}
for word in text.split() {
    counts[word] = get(counts, word, 0) + 1
}
print("'the' appears", counts["the"], "times")

// Maps holding functions work like simple objects
func makeAccount(owner) {
    account := {owner: owner, balance: 0}
    account.deposit = func(amount) {
        account.balance += amount
        return account.balance
    }
    return account
}
acct := makeAccount("Grace")
acct.deposit(50)
print(acct.owner, "has", acct.deposit(25))
