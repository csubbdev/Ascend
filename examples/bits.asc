// Bitwise operators: & | ^ ~ << >>
// Unlike C, they bind tighter than comparisons, so `x & 1 == 0` works as expected.

READ: u8 = 0b001
WRITE: u8 = 0b010
EXECUTE: u8 = 0b100

permissions: u8 = READ | WRITE
print("can write?", permissions & WRITE != 0)
print("can execute?", permissions & EXECUTE != 0)

permissions |= EXECUTE     // grant
permissions &= ~WRITE      // revoke
print(f"permissions = {permissions:03b}")

// Packing a color into 24 bits and unpacking it again.
func pack(r: u8, g: u8, b: u8) -> u32 {
    return u32(r) << 16 | u32(g) << 8 | u32(b)
}

color := pack(255, 128, 0)
print(f"color = {hex(color)}, red = {color >> 16 & 0xFF}, green = {color >> 8 & 0xFF}, blue = {color & 0xFF}")

// Count the 1 bits in a number.
func popcount(n: u64) -> i32 {
    count := 0
    while n != 0 {
        count += n & 1
        n >>= 1
    }
    return count
}
print("bits set in 0xFF00FF:", popcount(0xFF00FF))

// The bytes of a string (UTF-8).
for b in bytes("Hi!") {
    print(f"{b:3} = {b:08b} = {char(b)}")
}
