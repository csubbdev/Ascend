// Save some data as JSON, read it back and use it.
path := "ascend_example_scores.json"

scores := {
    players: [
        {name: "Ada", score: 120},
        {name: "Grace", score: 95},
        {name: "Linus", score: 110},
    ],
    saved: date("%Y-%m-%d"),
}
write_file(path, json_stringify(scores, 2))
print("wrote", len(read_lines(path)), "lines to", path)

loaded := json_parse(read_file(path))
ranking := sort(loaded.players, func(p) { return -p.score })
for place, player in ranking {
    print(f"{place + 1}. {player.name:<6} {player.score:>4}")
}

best := ranking[0]
print(f"best: {best.name}, total: {sum(map(loaded.players, func(p) { return p.score }))}")

delete_file(path)
print("cleaned up:", not file_exists(path))
