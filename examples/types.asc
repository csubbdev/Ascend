// Typed variables: name: type = value
age: u8 = 30
temperature: i16 = -12
population: u64 = 8_100_000_000
ratio: f32 = 0.75
precise: f64 = 3.141592653589793
grade: char = 'A'
name: string = "Ada"
active: bool = true
nickname: string?        // the ? allows null; this starts as null
count: i32               // without a value it starts at zero

print(name, age, temperature, population, ratio, precise, grade, active, nickname, count)
print(type(age), type(ratio), type(grade), type(42), type(4.2))

// A typed variable only ever holds values of its type.
age += 1
print(f"{name} is now {age} ({type(age)})")
try {
    age = 300
} catch e {
    print("error:", e)
}

// Arithmetic stays in the type, and overflow is an error instead of a silent wrap.
small: u8 = 250
try {
    small += 10
} catch e {
    print("error:", e)
}

// Mixing types widens to a type that holds both.
a: u8 = 200
b: i32 = -1000
print(type(a + b), a + b)

// Explicit conversions use the type name.
print(u8(65), char(66), i32("42") + 1, f32(1) / 3, int(9.99), byte('A'))

// Constants can't be changed.
const MAX_PLAYERS: u8 = 4
print("max players:", MAX_PLAYERS)

// Typed parameters and return values.
func average(values: list) -> f64 {
    if len(values) == 0 {
        return 0
    }
    return sum(values) / f64(len(values))
}
print("average:", average([3, 4, 8]))

func describe(n: i64) -> string {
    match n {
        0 => return "zero"
        1, 2, 3 => return "a few"
        else => return n < 0 ? "negative" : "many"
    }
}
print(describe(0), describe(2), describe(-5), describe(100))
