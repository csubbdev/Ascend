x := 10 + 5
print(x)  // Output: 15

y := x * 2
print(y)  // Output: 30

// print("y value" + y)  // TODO: ADD SUPPORT FOR THIS

z := (y + 5) * 3
print(z)  // Output: 105

// print("z value", z)   // TODO: ADD SUPPORT FOR THIS

mod := 17 % 5
print(mod)  // Output: 2

/* 
multi-line comments woo hoo
*/

fact := 1
for i in range(1, 6) {  // Will iterate i from 0 to 5
    if i > 0 {      // Skip multiplication by 0
        fact := fact * i
    }
}
print(fact)  // Should calculate factorial of 5 (5! = 120)