// strings: extra tools for working with text.
//
//     strings := import("strings")
//     print(strings.snake_case("userName"))        // user_name
//     print(strings.fill(long_text, 60))           // wrapped to 60 columns

// "hello world" -> "Hello world"
string capitalize(string s) {
    if s == "" {
        return s
    }
    return upper(s[0]) + s[1:]
}

// "hello big world" -> "Hello Big World"
string title(string s) {
    out := []
    start := true
    for c in s {
        out.push(start ? upper(c) : lower(c))
        start = is_space(c) or c == '-'
    }
    return join(out)
}

// The words in a name or sentence, in lower case. Splits on spaces, '_', '-'
// and other punctuation, and where camelCase changes case:
// "parseHTTPResponse_v2" -> ["parse", "http", "response", "v2"]
list words(string s) {
    result := []
    current := []
    cs := chars(s)
    for i, c in cs {
        if not is_alnum(c) {
            if len(current) > 0 {
                result.push(lower(join(current)))
                current = []
            }
            continue
        }
        if len(current) > 0 and is_upper(c) {
            previous := cs[i - 1]
            next_is_lower := i + 1 < len(cs) and is_lower(cs[i + 1])
            if is_lower(previous) or is_digit(previous) or (is_upper(previous) and next_is_lower) {
                result.push(lower(join(current)))
                current = []
            }
        }
        current.push(c)
    }
    if len(current) > 0 {
        result.push(lower(join(current)))
    }
    return result
}

string snake_case(string s) { return join(words(s), "_") }
string kebab_case(string s) { return join(words(s), "-") }
string constant_case(string s) { return upper(join(words(s), "_")) }

string camel_case(string s) {
    parts := words(s)
    for i in range(1, len(parts)) {
        parts[i] = capitalize(parts[i])
    }
    return join(parts)
}

string pascal_case(string s) {
    return join(map(words(s), capitalize))
}

// Text for use in a URL or file name: "Hello, World!" -> "hello-world"
string slugify(string s) {
    return join(words(s), "-")
}

// Centers s in a field of `width` characters.
string center(s, i64 width, char fill = ' ') {
    text := str(s)
    space := width - len(text)
    if space <= 0 {
        return text
    }
    left := space / 2
    return fill * left + text + fill * (space - left)
}

// Shortens s to at most `width` characters, ending with `ending` if it was cut.
string truncate(s, i64 width, string ending = "...") {
    text := str(s)
    if len(text) <= width {
        return text
    }
    if width <= len(ending) {
        return text[:width]
    }
    return text[:width - len(ending)] + ending
}

// Splits text into lines of at most `width` characters, breaking between words.
// Words longer than `width` get a line of their own.
list wrap(string text, i64 width) {
    if width < 1 {
        throw "strings.wrap: width must be at least 1"
    }
    result := []
    for paragraph in lines(text) {
        line := ""
        for word in split(paragraph) {
            if line == "" {
                line = word
            } else if len(line) + 1 + len(word) <= width {
                line += " " + word
            } else {
                result.push(line)
                line = word
            }
        }
        result.push(line)
    }
    return result
}

// wrap(), joined into one string.
string fill(string text, i64 width) {
    return join(wrap(text, width), "\n")
}

// Adds `prefix` to the start of every line that isn't empty.
string indent(string text, string prefix = "    ") {
    out := []
    for line in split(text, "\n") {
        out.push(trim(line) == "" ? line : prefix + line)
    }
    return join(out, "\n")
}

// Removes the indentation that every non-empty line shares.
string dedent(string text) {
    all_lines := split(text, "\n")
    common := -1
    for line in all_lines {
        if trim(line) == "" {
            continue
        }
        n := 0
        while n < len(line) and (line[n] == ' ' or line[n] == '\t') {
            n += 1
        }
        if common == -1 or n < common {
            common = n
        }
    }
    if common <= 0 {
        return text
    }
    out := []
    for line in all_lines {
        out.push(trim(line) == "" ? "" : line[common:])
    }
    return join(out, "\n")
}

string remove_prefix(string s, string prefix) {
    return starts_with(s, prefix) ? s[len(prefix):] : s
}

string remove_suffix(string s, string suffix) {
    return suffix != "" and ends_with(s, suffix) ? s[:len(s) - len(suffix)] : s
}

bool is_blank(string s) {
    return trim(s) == ""
}

i64 count_words(string s) {
    return len(split(s))
}

// Reads the same backwards, ignoring case, spaces and punctuation.
bool is_palindrome(string s) {
    letters := lower(join(filter(chars(s), is_alnum)))
    return letters == reverse(letters)
}

// How many single-character edits turn a into b (Levenshtein distance).
i64 distance(string a, string b) {
    x := chars(a)
    y := chars(b)
    previous := range(len(y) + 1)
    for i in range(len(x)) {
        current := [i + 1]
        for j in range(len(y)) {
            cost := x[i] == y[j] ? 0 : 1
            current.push(min(previous[j + 1] + 1, current[j] + 1, previous[j] + cost))
        }
        previous = current
    }
    return previous[len(y)]
}

// The candidate closest to `word`, or null if none is within `max_distance` edits.
// Handy for "did you mean ...?" messages.
string? closest(string word, list candidates, i64 max_distance = 3) {
    best := null
    best_distance := max_distance + 1
    for candidate in candidates {
        d := distance(lower(word), lower(str(candidate)))
        if d < best_distance {
            best = str(candidate)
            best_distance = d
        }
    }
    return best
}
