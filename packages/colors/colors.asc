// colors: color and style text in the terminal.
//
//     colors := import("colors")
//     print(colors.green("ok"), colors.style("failed", "bold red"))
//
// Colors are turned off when the NO_COLOR environment variable is set
// (see https://no-color.org), or by calling colors.enable(false).

const _ESC = "\x1b["

_enabled := env("NO_COLOR") == null || env("NO_COLOR") == ""

// Style names and their ANSI codes. "on_<color>" names set the background.
const _CODES = {
    reset: 0, bold: 1, dim: 2, italic: 3, underline: 4, blink: 5, inverse: 7, hidden: 8, strike: 9,
    black: 30, red: 31, green: 32, yellow: 33, blue: 34, magenta: 35, cyan: 36, white: 37, gray: 90,
    bright_red: 91, bright_green: 92, bright_yellow: 93, bright_blue: 94, bright_magenta: 95,
    bright_cyan: 96, bright_white: 97,
    on_black: 40, on_red: 41, on_green: 42, on_yellow: 43, on_blue: 44, on_magenta: 45, on_cyan: 46,
    on_white: 47, on_gray: 100
}

// Turns colors on or off for everything that uses this package.
void enable(bool on = true) {
    _enabled = on
}

bool enabled() {
    return _enabled
}

// All the style names style() accepts.
list names() {
    return keys(_CODES)
}

// Applies styles given as names separated by spaces: style("hi", "bold red on_white").
string style(text, string styles) {
    codes := []
    for name in split(styles) {
        if not (name in _CODES) {
            throw f"colors: there's no style named '{name}' (see colors.names())"
        }
        codes.push(_CODES[name])
    }
    if not _enabled or len(codes) == 0 {
        return str(text)
    }
    return _ESC + join(codes, ";") + "m" + str(text) + _ESC + "0m"
}

// Any color, given as red, green and blue amounts from 0 to 255.
string rgb(text, u8 r, u8 g, u8 b) {
    if not _enabled {
        return str(text)
    }
    return f"{_ESC}38;2;{r};{g};{b}m{text}{_ESC}0m"
}

// The same for the background.
string on_rgb(text, u8 r, u8 g, u8 b) {
    if not _enabled {
        return str(text)
    }
    return f"{_ESC}48;2;{r};{g};{b}m{text}{_ESC}0m"
}

// A color given in hex, like "#ff8800" or "f80".
string hex(text, string color) {
    digits := color
    if starts_with(digits, "#") {
        digits = digits[1:]
    }
    if len(digits) == 3 {
        digits = digits[0] * 2 + digits[1] * 2 + digits[2] * 2
    }
    if len(digits) != 6 {
        throw f"colors: '{color}' isn't a hex color like \"#ff8800\""
    }
    return rgb(text, u8("0x" + digits[0:2]), u8("0x" + digits[2:4]), u8("0x" + digits[4:6]))
}

// Removes color codes, e.g. to measure how wide colored text is.
string strip(string text) {
    out := []
    cs := chars(text)
    i := 0
    while i < len(cs) {
        if cs[i] == '\x1b' and i + 1 < len(cs) and cs[i + 1] == '[' {
            i += 2
            while i < len(cs) and not is_alpha(cs[i]) {
                i += 1
            }
            i += 1
            continue
        }
        out.push(cs[i])
        i += 1
    }
    return join(out)
}

string bold(text) { return style(text, "bold") }
string dim(text) { return style(text, "dim") }
string italic(text) { return style(text, "italic") }
string underline(text) { return style(text, "underline") }
string inverse(text) { return style(text, "inverse") }
string strike(text) { return style(text, "strike") }

string black(text) { return style(text, "black") }
string red(text) { return style(text, "red") }
string green(text) { return style(text, "green") }
string yellow(text) { return style(text, "yellow") }
string blue(text) { return style(text, "blue") }
string magenta(text) { return style(text, "magenta") }
string cyan(text) { return style(text, "cyan") }
string white(text) { return style(text, "white") }
string gray(text) { return style(text, "gray") }
