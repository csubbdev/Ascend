// testing: write and run unit tests.
//
//     t := import("testing")
//
//     t.test("adding numbers", func() {
//         t.equal(1 + 1, 2)
//     })
//     t.test("dividing by zero is an error", func() {
//         t.throws(func() { return 1 / 0 }, "division by zero")
//     })
//
//     t.run()    // prints the results; exits with code 1 if a test failed

colors := import("colors")

_tests := []

// Adds a test. `body` is a function with no parameters that uses the checks below.
void test(string name, func body) {
    _tests.push({name: name, body: body, skip: false})
}

// Adds a test that's reported but not run, e.g. while it's being fixed.
void skip(string name, func body) {
    _tests.push({name: name, body: body, skip: true})
}

// Stops the current test and reports it as failed.
void fail(string message = "failed") {
    throw {_testing_failure: true, message: message}
}

void ok(condition, string message = "expected a true value") {
    if not condition {
        fail(f"{message} (got {repr(condition)})")
    }
}

void equal(actual, expected, string message = "") {
    if actual != expected {
        fail((message == "" ? "" : message + ": ") + f"expected {repr(expected)}, got {repr(actual)}")
    }
}

void not_equal(actual, unexpected, string message = "") {
    if actual == unexpected {
        fail((message == "" ? "" : message + ": ") + f"expected anything but {repr(unexpected)}")
    }
}

// Checks that two numbers are within `tolerance` of each other.
void close(f64 actual, f64 expected, f64 tolerance = 1e-9) {
    if abs(actual - expected) > tolerance {
        fail(f"expected {expected} (within {tolerance}), got {actual}")
    }
}

// Checks that calling `body` throws an error, and that the error message
// contains `contains` when it's given. Returns the error.
func throws(func body, string? contains = null) {
    try {
        body()
    } catch e {
        if type(e) == "map" and get(e, "_testing_failure", false) {
            throw e
        }
        if contains != null and not (contains in str(e)) {
            fail(f"expected an error containing {repr(contains)}, got {repr(str(e))}")
        }
        return e
    }
    fail("expected an error, but nothing was thrown")
}

// Runs every test added so far and prints a report. Ends the program with
// exit code 1 if any test failed; otherwise returns the number of tests run.
i64 run() {
    passed := 0
    failed := []
    skipped := 0
    started := clock()
    for entry in _tests {
        if entry.skip {
            skipped += 1
            print(colors.yellow("  skip"), entry.name)
            continue
        }
        try {
            entry.body()
            passed += 1
            print(colors.green("  pass"), entry.name)
        } catch e {
            message := type(e) == "map" and get(e, "_testing_failure", false) ? e.message : "error: " + str(e)
            failed.push({name: entry.name, message: message})
            print(colors.red("  FAIL"), entry.name)
            print(colors.gray("       " + replace(message, "\n", "\n       ")))
        }
    }
    _tests = []

    seconds := clock() - started
    summary := f"{passed} passed"
    if len(failed) > 0 {
        summary += ", " + colors.red(f"{len(failed)} failed")
    }
    if skipped > 0 {
        summary += ", " + colors.yellow(f"{skipped} skipped")
    }
    print()
    print(summary + colors.gray(f" ({seconds:.2f}s)"))
    if len(failed) > 0 {
        print()
        print("Failed tests:")
        for failure in failed {
            print(f"  {failure.name}: {failure.message}")
        }
        exit(1)
    }
    return passed
}
